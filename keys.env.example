# API keys for MAVIS. Copy this file to keys.env (setup.bat does it) and fill in what you have.
# keys.env stays on this computer and is git-ignored. Never commit real keys.
# One KEY=value per line, no quotes, no spaces around "=".

# OCR mode - which service reads scanned pages. OPTIONAL: with no key, pages are read on this computer by MAVIS's
# local OCR engine (works offline). A key gives cloud OCR when online; offline, MAVIS still falls back to local.
GEMINI_API_KEY=
# OCRSPACE_API_KEY=
# MAVIS_OCR_PROVIDER=ocrspace

# Drishti - optional. Without it, Drishti asks for a key inside the app (or runs its local, on-device models).
GROQ_API_KEY=
# SARVAM_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# MAVIS question answering runs locally through Ollama (https://ollama.com):  ollama pull gemma3:4b
# Other MAVIS settings: modules/mavis/docs/SETUP.md
